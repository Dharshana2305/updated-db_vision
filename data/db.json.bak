      "id": "REC-PERF-FK-IDX-order_items-product_id",
      "projectId": "PRJ-1791394211922",
      "findingId": "PERF-FK-IDX-order_items-product_id",
      "title": "Missing Index on Foreign Key \"order_items.product_id\"",
      "problem": "Foreign key column \"product_id\" in table \"order_items\" references \"products.id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
      "recommendation": "Add a B-Tree index on \"order_items\" (\"product_id\").",
      "why": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
      "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
      "risk": "LOW",
      "safetyChecks": {
        "potentialLocks": "Brief shared metadata lock during index creation",
