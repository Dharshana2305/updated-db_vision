          "id": "SEC-PII-patients-national_id_number",
          "title": "Unencrypted Government Identity Number (PII) in \"patients\"",
          "category": "security",
          "severity": "HIGH",
          "description": "Column \"national_id_number\" contains sensitive government identity records (SSN/National ID/Aadhaar). These identifiers must be protected with field-level encryption or pseudonymization.",
          "evidence": "Government identifier detected in schema: \"national_id_number\" (VARCHAR(30))",
          "databaseObject": "patients.national_id_number",
          "table": "patients",
          "column": "national_id_number",
          "whyItMatters": "National identification numbers can facilitate identity theft, synthetic identity fraud, and severe regulatory penalties under GDPR/HIPAA/DPDP.",
          "recommendation": "Encrypt this column at rest using envelope encryption (AES-256-GCM) or tokenization.",
          "confidence": 92,
          "risk": "HIGH",
          "expectedImpact": "Safeguards individual citizen privacy and satisfies data residency/privacy legislation.",
          "suggestedFix": "-- Recommended: Mask or store last 4 digits only for display\nALTER TABLE \"patients\" ADD COLUMN \"national_id_number_last4\" VARCHAR(4);",
          "status": "APPLIED",
          "safeToApplyAuto": false
        },
        {
          "id": "PERF-FK-IDX-appointments-doctor_id",
          "title": "Missing Index on Foreign Key \"appointments.doctor_id\"",
          "category": "performance",
          "severity": "HIGH",
          "description": "Foreign key column \"doctor_id\" in table \"appointments\" references \"doctors.doctor_id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
          "evidence": "Table \"appointments\" contains foreign key on \"doctor_id\" without an index.",
          "databaseObject": "appointments.doctor_id",
          "table": "appointments",
          "column": "doctor_id",
          "whyItMatters": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
          "recommendation": "Add a B-Tree index on \"appointments\" (\"doctor_id\").",
          "confidence": 99,
          "risk": "LOW",
          "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
          "suggestedFix": "CREATE INDEX IF NOT EXISTS \"idx_appointments_doctor_id\" ON \"appointments\" (\"doctor_id\");",
          "rollbackSql": "DROP INDEX IF EXISTS \"idx_appointments_doctor_id\";",
          "status": "APPLIED",
          "safeToApplyAuto": true
