      "findings": [
        {
          "id": "QUAL-PHONE-FMT-customers-contact_phone-1",
          "title": "Inconsistent Phone Number Formats in \"customers.contact_phone\"",
          "category": "quality",
          "severity": "LOW",
          "description": "Phone numbers are stored in conflicting notations: Dashed local, E.164 (international), Raw digits.",
          "evidence": "Found multiple formats (Dashed local, E.164 (international), Raw digits) in table sample.",
          "databaseObject": "customers.contact_phone",
          "table": "customers",
          "column": "contact_phone",
          "whyItMatters": "Lack of canonical formatting (e.g. E.164 +1234567890) breaks SMS dispatch gateways, telephony dialers, and complicates deduplication.",
          "recommendation": "Standardize phone numbers to E.164 international standard format before inserting.",
          "confidence": 88,
          "risk": "LOW",
          "expectedImpact": "Enables dependable SMS gateway delivery and accurate entity deduplication.",
          "suggestedFix": "-- Standardize phone numbers to E.164 format: +[country_code][subscriber_number]",
          "status": "OPEN",
          "safeToApplyAuto": false
        }
      ],
      "summary": "Automated comprehensive review completed on 8 tables (41 columns, 330 total rows). Discovered 1 findings (0 critical).",
