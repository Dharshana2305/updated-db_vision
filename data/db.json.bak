    {
      "id": "REC-SEC-PW-users-pwd",
      "projectId": "PRJ-1791718707113",
      "findingId": "SEC-PW-users-pwd",
      "title": "Potential Plaintext Password Column in \"users\"",
      "problem": "The column \"pwd\" in table \"users\" strongly indicates password storage. If raw or weakly encrypted passwords are kept in the database, a single leak compromises all user accounts.",
      "recommendation": "Migrate column to store salted crypt hashes (e.g. bcrypt $2b$ or Argon2) and rename to \"pwd_hash\".",
      "why": "Storing unhashed or unsalted credentials violates security compliance (OWASP Top 10, NIST SP 800-63B, ISO 27001). Passwords must always be hashed using strong one-way algorithms like Argon2id or bcrypt with random salt.",
      "expectedImpact": "Eliminates credential exposure hazard during database breach or backup exposure.",
      "risk": "HIGH",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "users"
        ],
        "affectedObjects": [
          "users.pwd"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "-- Recommended SQL Migration\nALTER TABLE \"users\" ADD COLUMN \"pwd_hash\" VARCHAR(255);\n-- 1. Batch hash existing values via application service\n-- 2. Drop the plaintext column once migrated",
      "rollbackOperation": "-- Rollback will update governance log status",
      "status": "APPLIED",
      "appliedAt": "2026-10-11T11:38:33.110Z",
      "appliedResult": "1-Click fix applied: ALTER TABLE \"users\" ADD COLUMN \"pwd_hash\" VARCHAR(255);"
    },
    {
      "id": "REC-SEC-PII-users-ssn",
      "projectId": "PRJ-1791718707113",
      "findingId": "SEC-PII-users-ssn",
      "title": "Unencrypted Government Identity Number (PII) in \"users\"",
      "problem": "Column \"ssn\" contains sensitive government identity records (SSN/National ID/Aadhaar). These identifiers must be protected with field-level encryption or pseudonymization.",
      "recommendation": "Encrypt this column at rest using envelope encryption (AES-256-GCM) or tokenization.",
      "why": "National identification numbers can facilitate identity theft, synthetic identity fraud, and severe regulatory penalties under GDPR/HIPAA/DPDP.",
      "expectedImpact": "Safeguards individual citizen privacy and satisfies data residency/privacy legislation.",
      "risk": "HIGH",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "users"
        ],
        "affectedObjects": [
          "users.ssn"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "-- Recommended: Mask or store last 4 digits only for display\nALTER TABLE \"users\" ADD COLUMN \"ssn_last4\" VARCHAR(4);",
      "rollbackOperation": "-- Rollback will update governance log status",
      "status": "APPLIED",
      "appliedAt": "2026-10-11T11:38:33.503Z",
      "appliedResult": "1-Click fix applied: ALTER TABLE \"users\" ADD COLUMN \"ssn_last4\" VARCHAR(4);"
    },
