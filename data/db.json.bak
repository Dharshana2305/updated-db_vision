          "title": "Missing Index on Foreign Key \"supply_chain.product_id\"",
          "category": "performance",
          "severity": "HIGH",
          "description": "Foreign key column \"product_id\" in table \"supply_chain\" references \"products.product_id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
          "evidence": "Table \"supply_chain\" contains foreign key on \"product_id\" without an index.",
          "databaseObject": "supply_chain.product_id",
          "table": "supply_chain",
          "column": "product_id",
          "whyItMatters": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
          "recommendation": "Add a B-Tree index on \"supply_chain\" (\"product_id\").",
          "confidence": 99,
          "risk": "LOW",
          "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
          "suggestedFix": "CREATE INDEX \"idx_supply_chain_product_id\" ON \"supply_chain\" (\"product_id\");",
          "rollbackSql": "DROP INDEX \"idx_supply_chain_product_id\";",
          "status": "APPLIED",
          "safeToApplyAuto": true
        },
