    {
      "id": "REC-SEC-PCI-payments-card_number",
      "projectId": "PRJ-1790270797566",
      "findingId": "SEC-PCI-payments-card_number",
      "title": "Direct Payment Card / CVV Storage in \"payments\"",
      "problem": "Column \"card_number\" appears to store primary account numbers (PAN) or card verification values (CVV). PCI-DSS Req 3.2 strictly prohibits storing CVV post-authorization under any circumstances.",
      "recommendation": "Replace raw payment storage with tokenized IDs from a certified payment processor (e.g. Stripe, Razorpay). Never persist CVV.",
      "why": "Direct storage of raw credit card PAN and CVV numbers exposes the organization to catastrophic liability, regulatory fines, and payment network revocation.",
      "expectedImpact": "Achieves PCI-DSS compliance and protects customer financial assets.",
      "risk": "HIGH",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "payments"
        ],
        "affectedObjects": [
          "payments.card_number"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "-- Replace with payment processor token reference\nALTER TABLE \"payments\" ADD COLUMN payment_token VARCHAR(100);\n-- DROP the raw card number/CVV columns",
      "rollbackOperation": "-- Rollback will update governance log status",
      "status": "APPLIED",
      "appliedAt": "2026-09-27T17:39:58.428Z",
      "appliedResult": "Successfully executed on database: ALTER TABLE \"payments\" ADD COLUMN payment_token VARCHAR(100); (5 rows affected)"
    },
