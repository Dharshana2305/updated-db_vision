          "id": "PERF-FK-IDX-patient_bills-appointment_id",
          "title": "Missing Index on Foreign Key \"patient_bills.appointment_id\"",
          "category": "performance",
          "severity": "HIGH",
          "description": "Foreign key column \"appointment_id\" in table \"patient_bills\" references \"appointments.appointment_id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
          "evidence": "Table \"patient_bills\" contains foreign key on \"appointment_id\" without an index.",
          "databaseObject": "patient_bills.appointment_id",
          "table": "patient_bills",
          "column": "appointment_id",
          "whyItMatters": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
          "recommendation": "Add a B-Tree index on \"patient_bills\" (\"appointment_id\").",
          "confidence": 99,
          "risk": "LOW",
          "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
          "suggestedFix": "CREATE INDEX IF NOT EXISTS \"idx_patient_bills_appointment_id\" ON \"patient_bills\" (\"appointment_id\");",
