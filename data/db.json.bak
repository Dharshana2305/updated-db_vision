          "title": "Direct Payment Card / CVV Storage in \"payments\"",
          "category": "security",
          "severity": "CRITICAL",
          "description": "Column \"card_number\" appears to store primary account numbers (PAN) or card verification values (CVV). PCI-DSS Req 3.2 strictly prohibits storing CVV post-authorization under any circumstances.",
          "evidence": "Matches PCI prohibited field: \"card_number\"",
          "databaseObject": "payments.card_number",
          "table": "payments",
          "column": "card_number",
          "whyItMatters": "Direct storage of raw credit card PAN and CVV numbers exposes the organization to catastrophic liability, regulatory fines, and payment network revocation.",
          "recommendation": "Replace raw payment storage with tokenized IDs from a certified payment processor (e.g. Stripe, Razorpay). Never persist CVV.",
          "confidence": 98,
          "risk": "HIGH",
          "expectedImpact": "Achieves PCI-DSS compliance and protects customer financial assets.",
          "suggestedFix": "-- Replace with payment processor token reference\nALTER TABLE \"payments\" ADD COLUMN payment_token VARCHAR(100);\n-- DROP the raw card number/CVV columns",
          "status": "APPLIED",
          "safeToApplyAuto": false
        },
