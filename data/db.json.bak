    {
      "id": "REC-DES-3NF-DERIVED-order_items-subtotal",
      "projectId": "PRJ-1791394211922",
      "findingId": "DES-3NF-DERIVED-order_items-subtotal",
      "title": "Derived / Redundant Column \"subtotal\" in \"order_items\"",
      "problem": "The column \"subtotal\" in \"order_items\" appears to be a computed product of \"quantity\" * \"unit_price\". Storing calculated fields creates data inconsistency risks if one component updates without the other.",
      "recommendation": "Replace physical subtotal column with a generated virtual column or calculate dynamically in SELECT queries/views.",
      "why": "If unit_price or quantity is updated in an existing row and subtotal is not synchronously recalulated, the database contains invalid mathematical records.",
      "expectedImpact": "Eliminates synchronization anomalies between prices and totals.",
      "risk": "LOW",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "order_items"
        ],
        "affectedObjects": [
          "order_items.subtotal"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "CREATE VIEW IF NOT EXISTS \"v_order_items_with_totals\" AS SELECT *, (quantity * unit_price) AS subtotal FROM \"order_items\";",
      "rollbackOperation": "DROP VIEW IF EXISTS \"v_order_items_with_totals\";",
      "status": "APPLIED",
      "appliedAt": "2026-10-07T17:30:12.909Z",
      "appliedResult": "Approved & applied: CREATE VIEW IF NOT EXISTS \"v_order_items_with_totals\" AS SELECT *, (quantity * unit_price) AS subtot"
    },
