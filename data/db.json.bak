    {
      "id": "REC-SEC-PW-users-pwd",
      "projectId": "PRJ-1791393688226",
      "findingId": "SEC-PW-users-pwd",
      "title": "Potential Plaintext Password Column in \"users\"",
      "problem": "The column \"pwd\" in table \"users\" strongly indicates password storage. If raw or weakly encrypted passwords are kept in the database, a single leak compromises all user accounts.",
      "recommendation": "Migrate column to store salted crypt hashes (e.g. bcrypt $2b$ or Argon2) and rename to \"pwd_hash\".",
      "why": "Storing unhashed or unsalted credentials violates security compliance (OWASP Top 10, NIST SP 800-63B, ISO 27001). Passwords must always be hashed using strong one-way algorithms like Argon2id or bcrypt with random salt.",
      "expectedImpact": "Eliminates credential exposure hazard during database breach or backup exposure.",
      "risk": "HIGH",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "users"
        ],
        "affectedObjects": [
          "users.pwd"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "-- Recommended SQL Migration\nALTER TABLE \"users\" ADD COLUMN \"pwd_hash\" VARCHAR(255);\n-- 1. Batch hash existing values via application service\n-- 2. Drop the plaintext column once migrated",
      "rollbackOperation": "-- Rollback will update governance log status",
      "status": "APPLIED",
      "appliedAt": "2026-10-07T17:21:57.092Z",
      "appliedResult": "Approved & applied: ALTER TABLE \"users\" ADD COLUMN \"pwd_hash\" VARCHAR(255);"
    },
    {
      "id": "REC-DES-NO-PK-activity_log",
      "projectId": "PRJ-1791393688226",
      "findingId": "DES-NO-PK-activity_log",
      "title": "Table \"activity_log\" Lacks a Primary Key",
      "problem": "Table \"activity_log\" does not define any primary key constraint. Relational tables require unique record identification to maintain entity integrity.",
      "recommendation": "Add a surrogate primary key (e.g. \"id INTEGER PRIMARY KEY AUTOINCREMENT\" or UUID) to \"activity_log\".",
      "why": "Without a primary key, tables cannot be reliably indexed or uniquely referenced by foreign keys. ORMs, replication engines, and data deduplication tools fail or produce unpredictable duplicates.",
      "expectedImpact": "Guarantees entity uniqueness and allows foreign key reference integrity.",
      "risk": "MEDIUM",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "activity_log"
        ],
        "affectedObjects": [
          "activity_log"
        ],
        "potentialDataLoss": false,
        "breakingChanges": true,
        "safeToApply": true
      },
      "proposedOperation": "ALTER TABLE \"activity_log\" ADD COLUMN id INTEGER;\nUPDATE \"activity_log\" SET id = rowid WHERE id IS NULL;\nCREATE UNIQUE INDEX IF NOT EXISTS \"idx_activity_log_id\" ON \"activity_log\" (id);",
      "rollbackOperation": "DROP INDEX IF EXISTS \"idx_activity_log_id\";",
      "status": "APPLIED",
      "appliedAt": "2026-10-07T17:30:49.913Z",
      "appliedResult": "Remediation applied"
    },
