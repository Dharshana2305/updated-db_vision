          "category": "structure",
          "severity": "CRITICAL",
          "description": "Table \"_phone_standards\" does not define any primary key constraint. Relational tables require unique record identification to maintain entity integrity.",
          "evidence": "Table primaryKey array is empty: []",
          "databaseObject": "_phone_standards",
          "table": "_phone_standards",
          "whyItMatters": "Without a primary key, tables cannot be reliably indexed or uniquely referenced by foreign keys. ORMs, replication engines, and data deduplication tools fail or produce unpredictable duplicates.",
          "recommendation": "Add a surrogate primary key (e.g. \"id INTEGER PRIMARY KEY AUTOINCREMENT\" or UUID) to \"_phone_standards\".",
          "confidence": 100,
          "risk": "MEDIUM",
          "expectedImpact": "Guarantees entity uniqueness and allows foreign key reference integrity.",
          "suggestedFix": "ALTER TABLE \"_phone_standards\" ADD COLUMN id INTEGER PRIMARY KEY AUTOINCREMENT;",
