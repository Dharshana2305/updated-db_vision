      "projectId": "PRJ-1791394236119",
      "findingId": "PERF-FK-IDX-payments-order_id",
      "title": "Missing Index on Foreign Key \"payments.order_id\"",
      "problem": "Foreign key column \"order_id\" in table \"payments\" references \"orders.id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
      "recommendation": "Add a B-Tree index on \"payments\" (\"order_id\").",
      "why": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
      "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
      "risk": "LOW",
      "safetyChecks": {
        "potentialLocks": "Brief shared metadata lock during index creation",
        "dependencies": [
          "payments"
        ],
        "affectedObjects": [
          "payments.order_id"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "CREATE INDEX IF NOT EXISTS \"idx_payments_order_id\" ON \"payments\" (\"order_id\");",
      "rollbackOperation": "DROP INDEX IF EXISTS \"idx_payments_order_id\";",
      "status": "APPLIED"
    },
