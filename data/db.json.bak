          "category": "PERFORMANCE",
          "severity": "HIGH",
          "title": "Missing Index on orders(order_date) during batch range queries",
          "databaseObject": "orders.order_date",
          "confidence": 95,
          "risk": "HIGH",
          "description": "Full table scan observed during daily reconciliation queries filtering on order_date.",
          "whyItMatters": "Causes CPU spikes and slow execution on historical date aggregations.",
          "recommendation": "Add B-tree index on order_date.",
          "suggestedFix": "CREATE INDEX idx_orders_order_date ON orders(order_date);"
        },
        {
          "id": "FND-LEGACY-1789402899719-2",
          "category": "SECURITY",
          "severity": "CRITICAL",
          "title": "Plaintext Token column identified without hashing or salt",
          "databaseObject": "customer_sessions.session_token",
          "confidence": 98,
          "risk": "CRITICAL",
          "description": "Session tokens stored as raw unencrypted text.",
          "whyItMatters": "Exposure in database logs or unauthorized dump leads to complete session hijacking.",
          "recommendation": "Store SHA-256 digests instead of raw session tokens.",
          "suggestedFix": "ALTER TABLE customer_sessions ADD COLUMN token_hash TEXT;"
