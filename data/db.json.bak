          "id": "PERF-FK-IDX-employees-department_id-1",
          "title": "Missing Index on Foreign Key \"employees.department_id\"",
          "category": "performance",
          "severity": "HIGH",
          "description": "Foreign key column \"department_id\" in table \"employees\" references \"departments.department_id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
          "evidence": "Table \"employees\" contains foreign key on \"department_id\" without an index.",
          "databaseObject": "employees.department_id",
          "table": "employees",
          "column": "department_id",
          "whyItMatters": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
          "recommendation": "Add a B-Tree index on \"employees\" (\"department_id\").",
          "confidence": 99,
          "risk": "LOW",
          "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
          "suggestedFix": "CREATE INDEX \"idx_employees_department_id\" ON \"employees\" (\"department_id\");",
          "rollbackSql": "DROP INDEX \"idx_employees_department_id\";",
          "status": "APPLIED",
          "safeToApplyAuto": true
