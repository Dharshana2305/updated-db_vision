      "id": "REC-QUAL-PHONE-FMT-users-phone_number",
      "projectId": "PRJ-1791394211922",
      "findingId": "QUAL-PHONE-FMT-users-phone_number",
      "title": "Inconsistent Phone Number Formats in \"users.phone_number\"",
      "problem": "Phone numbers are stored in conflicting notations: E.164 (international), Raw digits, Dashed local.",
      "recommendation": "Standardize phone numbers to E.164 international standard format before inserting.",
      "why": "Lack of canonical formatting (e.g. E.164 +1234567890) breaks SMS dispatch gateways, telephony dialers, and complicates deduplication.",
      "expectedImpact": "Enables dependable SMS gateway delivery and accurate entity deduplication.",
