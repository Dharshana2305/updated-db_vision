      "proposedOperation": "ALTER TABLE \"activity_log\" ADD COLUMN id INTEGER;\nUPDATE \"activity_log\" SET id = rowid WHERE id IS NULL;\nCREATE UNIQUE INDEX IF NOT EXISTS \"idx_activity_log_id\" ON \"activity_log\" (id);",
