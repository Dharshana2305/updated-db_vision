      "findings": [
        {
          "id": "SEC-PCI-payments-card_number",
          "title": "Direct Payment Card / CVV Storage in \"payments\"",
          "category": "security",
          "severity": "CRITICAL",
          "description": "Column \"card_number\" appears to store primary account numbers (PAN) or card verification values (CVV). PCI-DSS Req 3.2 strictly prohibits storing CVV post-authorization under any circumstances.",
          "evidence": "Matches PCI prohibited field: \"card_number\"",
          "databaseObject": "payments.card_number",
          "table": "payments",
          "column": "card_number",
          "whyItMatters": "Direct storage of raw credit card PAN and CVV numbers exposes the organization to catastrophic liability, regulatory fines, and payment network revocation.",
          "recommendation": "Replace raw payment storage with tokenized IDs from a certified payment processor (e.g. Stripe, Razorpay). Never persist CVV.",
          "confidence": 98,
          "risk": "HIGH",
          "expectedImpact": "Achieves PCI-DSS compliance and protects customer financial assets.",
          "suggestedFix": "-- Replace with payment processor token reference\nALTER TABLE \"payments\" ADD COLUMN payment_token VARCHAR(100);\n-- DROP the raw card number/CVV columns",
          "status": "APPLIED",
          "safeToApplyAuto": false
        },
        {
          "id": "SEC-PCI-payments-card_cvv",
          "title": "Direct Payment Card / CVV Storage in \"payments\"",
          "category": "security",
          "severity": "CRITICAL",
          "description": "Column \"card_cvv\" appears to store primary account numbers (PAN) or card verification values (CVV). PCI-DSS Req 3.2 strictly prohibits storing CVV post-authorization under any circumstances.",
          "evidence": "Matches PCI prohibited field: \"card_cvv\"",
          "databaseObject": "payments.card_cvv",
          "table": "payments",
          "column": "card_cvv",
          "whyItMatters": "Direct storage of raw credit card PAN and CVV numbers exposes the organization to catastrophic liability, regulatory fines, and payment network revocation.",
          "recommendation": "Replace raw payment storage with tokenized IDs from a certified payment processor (e.g. Stripe, Razorpay). Never persist CVV.",
          "confidence": 98,
          "risk": "HIGH",
          "expectedImpact": "Achieves PCI-DSS compliance and protects customer financial assets.",
          "suggestedFix": "-- Replace with payment processor token reference\nALTER TABLE \"payments\" ADD COLUMN payment_token VARCHAR(100);\n-- DROP the raw card number/CVV columns",
          "status": "APPLIED",
          "safeToApplyAuto": false
        },
        {
          "id": "SEC-PW-users-pwd",
          "title": "Potential Plaintext Password Column in \"users\"",
          "category": "security",
          "severity": "CRITICAL",
          "description": "The column \"pwd\" in table \"users\" strongly indicates password storage. If raw or weakly encrypted passwords are kept in the database, a single leak compromises all user accounts.",
          "evidence": "Column name matches sensitive credential pattern: \"pwd\" (VARCHAR(100))",
          "databaseObject": "users.pwd",
          "table": "users",
          "column": "pwd",
          "whyItMatters": "Storing unhashed or unsalted credentials violates security compliance (OWASP Top 10, NIST SP 800-63B, ISO 27001). Passwords must always be hashed using strong one-way algorithms like Argon2id or bcrypt with random salt.",
          "recommendation": "Migrate column to store salted crypt hashes (e.g. bcrypt $2b$ or Argon2) and rename to \"pwd_hash\".",
          "confidence": 96,
          "risk": "HIGH",
          "expectedImpact": "Eliminates credential exposure hazard during database breach or backup exposure.",
          "suggestedFix": "-- Recommended SQL Migration\nALTER TABLE \"users\" ADD COLUMN \"pwd_hash\" VARCHAR(255);\n-- 1. Batch hash existing values via application service\n-- 2. Drop the plaintext column once migrated",
          "status": "APPLIED",
          "safeToApplyAuto": false
        },
        {
          "id": "DES-NO-PK-activity_log",
          "title": "Table \"activity_log\" Lacks a Primary Key",
          "category": "structure",
          "severity": "CRITICAL",
          "description": "Table \"activity_log\" does not define any primary key constraint. Relational tables require unique record identification to maintain entity integrity.",
          "evidence": "Table primaryKey array is empty: []",
          "databaseObject": "activity_log",
          "table": "activity_log",
          "whyItMatters": "Without a primary key, tables cannot be reliably indexed or uniquely referenced by foreign keys. ORMs, replication engines, and data deduplication tools fail or produce unpredictable duplicates.",
          "recommendation": "Add a surrogate primary key (e.g. \"id INTEGER PRIMARY KEY AUTOINCREMENT\" or UUID) to \"activity_log\".",
          "confidence": 100,
          "risk": "MEDIUM",
          "expectedImpact": "Guarantees entity uniqueness and allows foreign key reference integrity.",
          "suggestedFix": "ALTER TABLE \"activity_log\" ADD COLUMN id INTEGER;\nUPDATE \"activity_log\" SET id = rowid WHERE id IS NULL;\nCREATE UNIQUE INDEX IF NOT EXISTS \"idx_activity_log_id\" ON \"activity_log\" (id);",
          "rollbackSql": "DROP INDEX IF EXISTS \"idx_activity_log_id\";",
          "status": "APPLIED",
          "safeToApplyAuto": true
        },
        {
          "id": "SEC-PII-users-ssn",
          "title": "Unencrypted Government Identity Number (PII) in \"users\"",
          "category": "security",
          "severity": "HIGH",
          "description": "Column \"ssn\" contains sensitive government identity records (SSN/National ID/Aadhaar). These identifiers must be protected with field-level encryption or pseudonymization.",
          "evidence": "Government identifier detected in schema: \"ssn\" (VARCHAR(20))",
          "databaseObject": "users.ssn",
          "table": "users",
          "column": "ssn",
          "whyItMatters": "National identification numbers can facilitate identity theft, synthetic identity fraud, and severe regulatory penalties under GDPR/HIPAA/DPDP.",
          "recommendation": "Encrypt this column at rest using envelope encryption (AES-256-GCM) or tokenization.",
          "confidence": 92,
          "risk": "HIGH",
          "expectedImpact": "Safeguards individual citizen privacy and satisfies data residency/privacy legislation.",
          "suggestedFix": "-- Recommended: Mask or store last 4 digits only for display\nALTER TABLE \"users\" ADD COLUMN \"ssn_last4\" VARCHAR(4);",
          "status": "APPLIED",
          "safeToApplyAuto": false
        },
        {
          "id": "PERF-FK-IDX-order_items-product_id",
          "title": "Missing Index on Foreign Key \"order_items.product_id\"",
          "category": "performance",
          "severity": "HIGH",
          "description": "Foreign key column \"product_id\" in table \"order_items\" references \"products.id\" but has no supporting index. Joining or filtering by this key will cause sequential table scans.",
          "evidence": "Table \"order_items\" contains foreign key on \"product_id\" without an index.",
          "databaseObject": "order_items.product_id",
          "table": "order_items",
          "column": "product_id",
          "whyItMatters": "Foreign keys are heavily traversed in JOIN operations and parent row DELETES/UPDATES. Without an index, SQLite/PostgreSQL/MySQL must scan every row of the child table, creating CPU spikes and row lock contention as the table grows.",
          "recommendation": "Add a B-Tree index on \"order_items\" (\"product_id\").",
          "confidence": 99,
          "risk": "LOW",
          "expectedImpact": "Improves JOIN and foreign key lookup query speeds by 10x to 100x on medium-to-large datasets.",
          "suggestedFix": "CREATE INDEX IF NOT EXISTS \"idx_order_items_product_id\" ON \"order_items\" (\"product_id\");",
          "rollbackSql": "DROP INDEX IF EXISTS \"idx_order_items_product_id\";",
          "status": "APPLIED",
          "safeToApplyAuto": true
        },
