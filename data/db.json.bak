    {
      "id": "REC-DES-1NF-MULTI-products-tags",
      "projectId": "PRJ-1791394211922",
      "findingId": "DES-1NF-MULTI-products-tags",
      "title": "Potential 1NF Violation (Multi-Valued Attribute) in \"products.tags\"",
      "problem": "The column \"tags\" in \"products\" suggests non-atomic multi-valued items stored in a single field (e.g. comma-separated lists).",
      "recommendation": "Normalize into a junction/associative table (e.g. \"products_tags\") with a foreign key to \"products\".",
      "why": "1NF requires all attribute values to be atomic. Storing comma-separated lists prevents exact indexing, forces costly wildcard searches (LIKE \"%tag%\"), and prevents relational constraints.",
      "expectedImpact": "Enables exact index lookups, clean relational queries, and simplifies reporting.",
      "risk": "MEDIUM",
      "safetyChecks": {
        "potentialLocks": "Potential table lock depending on row count",
        "dependencies": [
          "products"
        ],
        "affectedObjects": [
          "products.tags"
        ],
        "potentialDataLoss": false,
        "breakingChanges": false,
        "safeToApply": true
      },
      "proposedOperation": "-- Recommended Schema Normalization:\nCREATE TABLE IF NOT EXISTS \"products_tags\" (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  \"products_id\" INTEGER NOT NULL,\n  value VARCHAR(100) NOT NULL,\n  FOREIGN KEY (\"products_id\") REFERENCES \"products\"(id)\n);",
      "rollbackOperation": "-- Rollback will update governance log status",
      "status": "APPLIED",
      "appliedAt": "2026-10-07T17:30:12.812Z",
      "appliedResult": "Approved & applied: CREATE TABLE IF NOT EXISTS \"products_tags\" (\nid INTEGER PRIMARY KEY AUTOINCREMENT,\n\"products_id\" INT"
    },
